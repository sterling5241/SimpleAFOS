#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

REPO="https://github.com/pellcorp/creality.git"

DEPS=(git python3-pip lsb-release)

########################################
# Install Dependencies                 #
########################################

echo "Installing Dependencies"
apt-get install --yes "${DEPS[@]}"

########################################
# Clone repository                     #
########################################

# Cloned before Kalico, which needs the Simple AF python requirements
pushd "/home/${BASE_USER}" &> /dev/null || exit 1
echo "Cloning repo ..."
sudo -u "${BASE_USER}" git clone ${REPO} pellcorp
popd &> /dev/null || exit 1

########################################
# Install configupdater                #
########################################

# Same package the Simple AF installer uses for editing configs
echo "Installing configupdater ..."
pip install --break-system-packages /home/"${BASE_USER}"/pellcorp/packages/ConfigUpdater-3.2-py2.py3-none-any.whl

########################################
# Simple AF boot splash                #
########################################

# The same steps as pellcorp/rpi/install-boot-display.sh
echo "Installing Simple AF boot splash ..."
# plymouth's initramfs hook copies /etc/fonts/fonts.conf and its label plugin,
# which Raspberry Pi OS lite does not have without fontconfig and plymouth-label
apt-get install --yes plymouth plymouth-label fontconfig unzip
mkdir -p /usr/share/plymouth/themes/simpleaf
unzip -qd /usr/share/plymouth/themes/simpleaf /home/"${BASE_USER}"/pellcorp/rpi/plymouth/simpleaf.zip
cp /home/"${BASE_USER}"/pellcorp/rpi/plymouth/simpleaf.plymouth /usr/share/plymouth/themes/simpleaf/
cp /home/"${BASE_USER}"/pellcorp/rpi/plymouth/simpleaf.script /usr/share/plymouth/themes/simpleaf/
plymouth-set-default-theme -R simpleaf

########################################
# Mark as preinstalled                 #
########################################

# Tells the Simple AF installer that moonraker, crowsnest and klipper are
# already installed, so its first install keeps them instead of starting over,
# and lets pellcorp/rpi/safos-setup.sh run that first install
sudo -u "${BASE_USER}" touch /home/"${BASE_USER}"/pellcorp.preinstalled
