#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

# the versioned zip releases include the release_info.json moonraker needs to update grumpyscreen
DOWNLOAD_URL="https://github.com/pellcorp/grumpyscreen/releases/latest/download/grumpyscreen-rpi.zip"

DEPS=(curl unzip)

apt-get install --yes "${DEPS[@]}"

########################################
# Download GrumpyScreen                #
########################################

# The same download as pellcorp/rpi/install-grumpyscreen.sh, which keeps it
pushd /home/"${BASE_USER}" &> /dev/null || exit 1
echo "Downloading GrumpyScreen ..."
sudo -u "${BASE_USER}" curl -L "${DOWNLOAD_URL}" -o grumpyscreen.zip
sudo -u "${BASE_USER}" mkdir -p grumpyscreen
sudo -u "${BASE_USER}" unzip -qd grumpyscreen grumpyscreen.zip
rm grumpyscreen.zip
chmod +x grumpyscreen/grumpyscreen
popd &> /dev/null || exit 1

########################################
# Copy service                         #
########################################

# Left disabled: safos-setup.sh --grumpyscreen enables it, and the Simple AF
# installer then finishes the setup the way it does for any enabled grumpyscreen
cp /home/"${BASE_USER}"/pellcorp/rpi/services/grumpyscreen.service /etc/systemd/system/grumpyscreen.service
sed -i "s:\$HOME:/home/${BASE_USER}:g" /etc/systemd/system/grumpyscreen.service
sed -i "s:User=pi:User=${BASE_USER}:g" /etc/systemd/system/grumpyscreen.service
